# Copier ce fichier en ".env" puis remplacer les valeurs. Ne jamais commiter ".env".
STACK_VERSION=8.15.3

# Mots de passe du lab (a choisir vous-meme)
ELASTIC_PASSWORD=changez-moi
KIBANA_PASSWORD=changez-moi-aussi

# Cle de 32 caracteres minimum, par exemple : openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=remplacez-par-une-cle-aleatoire-de-32-caracteres-minimum

# Interface reseau que Zeek doit ecouter (voir "ip a" sur la VM)
ZEEK_INTERFACE=eth0
